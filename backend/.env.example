# ── FIQO AI backend — environment template ────────────────────────────────
# Copy to `.env` and fill in real values. NEVER commit the real .env.
#   cp .env.example .env
#
# Nothing in this file is ever sent to the browser. The frontend only talks to
# this backend; the backend alone holds the Groq key.

# ── Core ────────────────────────────────────────────────────────────────────
APP_NAME=FIQO AI
ENVIRONMENT=production          # development | production
DEBUG=false                     # MUST be false in production
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR

# ── Secrets (REQUIRED in production — the app refuses to boot without them) ──
GROQ_API_KEY=your-groq-api-key-here
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value-at-least-32-chars

# ── AI ──────────────────────────────────────────────────────────────────────
GROQ_MODEL=llama-3.1-8b-instant
AI_MAX_INPUT_CHARS=8000
AI_MAX_INPUT_CHARS_MULTI=12000
AI_TIMEOUT_SECONDS=45           # never let a hung upstream call hold a worker
AI_MAX_RETRIES=1

# ── Auth / JWT ──────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256
JWT_ISSUER=FiQO-ai

# ── Database — managed Postgres in production, not SQLite ───────────────────
# Example: postgresql+psycopg://user:password@host:5432/FiQO
DATABASE_URL=postgresql+psycopg://FiQO:password@db:5432/FiQO
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ── CORS / hosts ────────────────────────────────────────────────────────────
# Comma-separated exact origins. NEVER "*" in production.
# With the bundled compose setup nginx proxies /api on the same origin, so this
# can stay empty — cross-origin requests never happen.
CORS_ORIGINS=https://your-frontend-domain.com
# Host header allowlist — blocks Host-header injection / DNS rebinding.
# Comma-separated hostnames, no scheme, no port.
# Keep localhost so `docker compose up` works before DNS points at you.
# Starlette compares the hostname only, so ports do not matter here.
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com,www.your-domain.com
# true ONLY when a proxy you control sits in front (nginx, Caddy, Cloudflare,
# Railway, Render, Fly). If the app is directly reachable, leave it false or
# anyone can forge X-Forwarded-For and bypass rate limiting.
TRUST_PROXY=true

# ── Public URL of the frontend ──────────────────────────────
# Where confirmation links point.
FRONTEND_URL=http://localhost:5173

# ── Email verification ──────────────────────────────────────
# Stops signups with addresses nobody owns ("asdf@asdf.com"). A new account
# cannot sign in until the link in its confirmation email is clicked.
# Automatically disabled if no mail transport is configured below.
REQUIRE_EMAIL_VERIFICATION=true
EMAIL_VERIFICATION_EXPIRE_HOURS=24
EMAIL_RESEND_COOLDOWN_SECONDS=60

# ── Password reset ──────────────────────────────────────────
# Reset links are short-lived on purpose: the link IS account access if it
# leaks, and the user is sitting at the screen waiting for it.
PASSWORD_RESET_EXPIRE_HOURS=1
PASSWORD_RESET_COOLDOWN_SECONDS=60

# ── Registration email hygiene ──────────────────────────────
# Off locally: it costs a DNS query per signup and blocks the fake addresses
# you probably want to use while developing. Turn both on in production.
CHECK_EMAIL_MX=false
BLOCK_DISPOSABLE_EMAIL=false
EXTRA_BLOCKED_EMAIL_DOMAINS=
ALLOWED_EMAIL_DOMAINS=

# ── Outbound mail ───────────────────────────────────────────
# smtp | brevo | resend | console
# 'console' prints the confirmation link straight into the backend log, so
# local development needs no mail account at all — copy the link from the
# terminal and paste it in the browser.
EMAIL_PROVIDER=console
EMAIL_FROM=FIQO AI <no-reply@localhost>

# ── Real delivery ───────────────────────────────────────────
#
# Brevo over HTTPS — the option to use on a PaaS.
# Render's free tier blocks outbound SMTP ports entirely, so smtp.gmail.com
# times out there however correct the credentials are. This uses port 443.
# Only the sender ADDRESS needs verifying (Brevo -> Senders), not a domain.
# EMAIL_PROVIDER=brevo
# BREVO_API_KEY=xkeysib-...
BREVO_API_KEY=

# Gmail over SMTP — fine on a VPS or locally, blocked on Render free.
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your.address@gmail.com
# SMTP_PASSWORD=<16-char Google App Password, no spaces>

# Resend over HTTPS. Without a verified domain it can only deliver to the
# account owner's own address, so it suits testing rather than real users.
# EMAIL_PROVIDER=resend
RESEND_API_KEY=

# ── Uploads ─────────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=15
MAX_FILES_PER_REQUEST=10
MAX_TOTAL_UPLOAD_MB=50          # cap across ALL files in one request
MAX_PDF_PAGES=500               # guards against page-count "PDF bombs"

# ── Rate limiting (SlowAPI syntax) ──────────────────────────────────────────
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_AI=15/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_FEEDBACK=5/minute
# Optional Redis so limits are shared across workers/replicas instead of being
# per-process (with 4 workers, in-memory limits are effectively 4x looser).
# RATE_LIMIT_STORAGE_URI=redis://redis:6379/0

# ── Optional first-run admin seeding ────────────────────────────────────────
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=use-a-strong-unique-password
ADMIN_NAME=Administrator
