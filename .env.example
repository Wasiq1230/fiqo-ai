# ─────────────────────────────────────────────────────────────
# docker compose variables (project root).
#   cp .env.example .env   and fill in real values.
# Application secrets live in backend/.env, not here.
# ─────────────────────────────────────────────────────────────

# Postgres — generate a long random password:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_USER=FiQO
POSTGRES_PASSWORD=
POSTGRES_DB=FiQO

# Host port for the web container (put HTTPS in front of this).
WEB_PORT=8080

# Your real public URL, no trailing slash — e.g. https://FiQO.example.com
# Used for SEO canonical tags, robots.txt and sitemap.xml.
SITE_URL=

# Leave EMPTY so the browser calls the API on the same origin through nginx.
# Only set this if you deliberately host the API on a separate domain.
VITE_API_URL=

# Gunicorn workers: (2 x CPU cores) + 1 is a good starting point.
WEB_CONCURRENCY=4
