# ─────────────────────────────────────────────────────────────
# Frontend environment (Vite)
# Copy to `.env` for local dev, or set these in your host's build config.
# Only variables prefixed with VITE_ are exposed to the browser bundle —
# NEVER put secrets (API keys, tokens) here; they would ship to every client.
# ─────────────────────────────────────────────────────────────

# Base URL of the backend API (no trailing slash).
# Local dev default (if unset): http://127.0.0.1:8000
# Production example:
VITE_API_URL=https://api.your-domain.com
